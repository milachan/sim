# =============================================================================
# Sistem Administrasi Guru — MTsN 2 Kebumen
# Contoh environment variable. Salin ke .env lalu isi sesuai lingkungan.
#   cp .env.example .env   (Linux/macOS)  atau  copy .env.example .env  (Windows)
# JANGAN commit file .env — hanya .env.example yang boleh masuk Git.
# =============================================================================

# --- WAJIB: database (MySQL / MariaDB) ---------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# Contoh lokal: mysql://root:@localhost:3306/sistem_guru
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/NAMA_DATABASE"

# --- WAJIB: NextAuth ---------------------------------------------------------
# URL publik aplikasi. Untuk development boleh http://localhost:3000.
# Untuk production HARUS URL HTTPS asli (mis. https://demo.example.sch.id) —
# jika masih localhost/127.0.0.1, validasi production akan menolak.
NEXTAUTH_URL="http://localhost:3000"

# Secret untuk menandatangani sesi/JWT. Minimal 32 karakter acak.
# Generate: openssl rand -base64 32   atau   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXTAUTH_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"

# --- OPSIONAL: cron / pengingat terjadwal -----------------------------------
# Secret bersama untuk mengamankan endpoint cron/pengingat. Dipakai sebagai
# header:  Authorization: Bearer <PUSH_CRON_SECRET>
# Jika tidak diisi, pemanggilan cron tanpa sesi akan ditolak (401) — fitur
# manual via UI admin tetap jalan (pakai sesi ADMIN).
# Kosongkan untuk menonaktifkan akses cron eksternal.
PUSH_CRON_SECRET=""

# --- OPSIONAL: Push Notification (Web Push / PWA) -----------------------------
# Pasangan kunci VAPID untuk Web Push. HARUS diisi berpasangan: jika salah satu
# diisi, keduanya + VAPID_SUBJECT wajib lengkap. Jika dikosongkan keduanya,
# aplikasi otomatis generate pasangan VAPID dan menyimpannya di tabel Setting
# (fallback — tetap berfungsi tanpa konfigurasi manual).
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Subject VAPID — format mailto: atau https:// — dipakai library web-push.
# Contoh: mailto:admin@sekolah.sch.id
VAPID_SUBJECT="mailto:admin@example.sch.id"

# --- OPSIONAL: WhatsApp (Fonnte) ---------------------------------------------
# Token device Fonnte. Jika dikosongkan, fallback ke pengaturan yang diisi
# lewat UI Admin → Pengaturan Sistem. Kosongkan keduanya untuk menonaktifkan WA.
WA_TOKEN=""

# --- OPSIONAL: Aplikasi BK (Bimbingan Konseling) ------------------------------
# URL aplikasi BK eksternal yang ditautkan. Jika dikosongkan, halaman /bk
# menampilkan pesan bahwa tautan belum dikonfigurasi. Harus URL http/https valid.
BK_APP_URL=""

# --- OTOMATIS (tidak perlu ditulis manual) -----------------------------------
# NODE_ENV diisi runtime: "development" | "production" | "test".
# Jangan tulis manual di .env kecuali untuk override khusus.
# NODE_ENV="production"

# --- OPSIONAL: Kotak akun demo di halaman login ------------------------------
# Set ke 1 untuk menampilkan chip akun demo (seed) di halaman login — khusus
# pengembangan lokal. Di produksi biarkan kosong agar tidak ada petunjuk akun
# yang bocor ke publik.
DEMO_LOGIN=""

# --- OPSIONAL: Verifikasi Dokumen (QR) ---------------------------------------
# NEXTAUTH_URL di atas SEKALIGUS menjadi base URL absolut halaman verifikasi
# dokumen final (/verifikasi-dokumen?kode=...). QR hanya memakai nilai ini —
# URL tidak pernah dibangun dari header Host request publik.
# - Development: boleh http://localhost:PORT atau http://IP-LAN:PORT.
# - Production: WAJIB HTTPS asli (non-localhost); helper akan menolak selain itu.
